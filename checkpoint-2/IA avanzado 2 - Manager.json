        "jsonSchemaExample": "\n{\n  \"intencion\": \"REGISTRAR\",\n  \"consulta\": \"Registrá un expediente laboral nuevo\",\n  \"expediente_id\": \"\",\n  \"motivo\": \"\",\n  \"datos\": {\n    \"Expediente\": \"González c/ Empresa del Sur S.A. s/ despido\",\n    \"Materia\": \"Laboral\",\n    \"Estado_procesal\": \"Traslado de demanda\",\n    \"Tarea_pendiente\": \"Preparar contestación\",\n    \"Responsable\": \"Dr. Martín López\",\n    \"Prioridad\": \"Alta\",\n    \"Estado_tarea\": \"Pendiente\",\n    \"Fecha_vencimiento\": \"2026-12-10\",\n    \"Ultima_actuacion\": \"\",\n    \"Observaciones\": \"\"\n  }\n}\n"
